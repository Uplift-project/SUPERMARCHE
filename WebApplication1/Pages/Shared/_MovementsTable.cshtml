@model IEnumerable<StockMovement>
@{
    var hideProduct = ViewData["HideProduct"] is true;
}
@if (!Model.Any())
{
    <p class="text-muted mb-0">Aucun mouvement.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-app table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    @if (!hideProduct) { <th>Produit</th> }
                    <th>Type</th>
                    <th class="num">Quantité</th>
                    <th class="num">Stock</th>
                    <th>Par</th>
                    <th>Motif</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var color = m.Type switch
                    {
                        StockMovementType.In => "green",
                        StockMovementType.Sale => "violet",
                        StockMovementType.Out => "amber",
                        StockMovementType.Order => "blue",
                        StockMovementType.OrderCancel => "red",
                        _ => "gray",
                    };
                    var label = m.Type.Label();
                    <tr>
                        <td class="small text-nowrap">@m.Date.ToString("dd/MM/yy HH:mm")</td>
                        @if (!hideProduct)
                        {
                            <td><a asp-page="/Products/Details" asp-route-id="@m.ProductId" class="text-decoration-none">@m.Product?.Name</a></td>
                        }
                        <td><span class="badge-soft @color">@label</span></td>
                        <td class="num fw-semibold" style="color:@(m.Quantity >= 0 ? "#006300" : "#b91c1c")">@(m.Quantity > 0 ? "+" : "")@m.Quantity</td>
                        <td class="num small text-muted">@m.QuantityBefore → <strong class="text-body">@m.QuantityAfter</strong></td>
                        <td class="text-nowrap">
                            @if (m.User != null)
                            {
                                <i class="bi bi-person"></i> @m.User.FullName
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="small">@m.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
