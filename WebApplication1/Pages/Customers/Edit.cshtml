@page "{id:int?}"
@model WebApplication1.Pages.Customers.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nouveau client" : "Modifier le client";
}
<div class="page-header">
    <div><h1>@ViewData["Title"]</h1></div>
    <a asp-page="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Retour</a>
</div>

<div class="card-app" style="max-width:720px">
    <form method="post">
        <input type="hidden" asp-for="Customer.Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Customer.FullName" class="form-label"></label>
                <input asp-for="Customer.FullName" class="form-control" />
                <span asp-validation-for="Customer.FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Customer.Phone" class="form-label"></label>
                <input asp-for="Customer.Phone" class="form-control" placeholder="06…" />
            </div>
            <div class="col-md-6">
                <label asp-for="Customer.Email" class="form-label"></label>
                <input asp-for="Customer.Email" class="form-control" />
                <span asp-validation-for="Customer.Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Customer.City" class="form-label"></label>
                <input asp-for="Customer.City" class="form-control" />
            </div>
            @if (!Model.IsNew)
            {
                <div class="col-md-6">
                    <label asp-for="Customer.LoyaltyPoints" class="form-label"></label>
                    <input asp-for="Customer.LoyaltyPoints" type="number" min="0" class="form-control" readonly="@(!Model.Access.IsSuperAdmin)" />
                    @if (!Model.Access.IsSuperAdmin) { <div class="form-text">Calculés automatiquement (1 point / 10 DH).</div> }
                </div>
            }
        </div>
        <div class="mt-4"><button class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Enregistrer</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
