@page "{id:int}"
@model WebApplication1.Pages.Sales.DetailsModel
@{
    ViewData["Title"] = "Vente " + Model.Sale.Number;
    var s = Model.Sale;
}
<div class="page-header">
    <div>
        <h1>Vente @s.Number</h1>
        <p>@s.Date.ToString("dd/MM/yyyy à HH:mm") · Caissier : @(s.User?.FullName ?? "—")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Retour</a>
        <button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimer</button>
    </div>
</div>

<div class="card-app" style="max-width:720px">
    <div class="mb-3">
        <strong>Client :</strong>
        @if (s.Customer != null) { <a asp-page="/Customers/Details" asp-route-id="@s.CustomerId">@s.Customer.FullName</a> } else { <span class="text-muted">Anonyme</span> }
    </div>
    <table class="table table-app">
        <thead><tr><th>Produit</th><th class="num">Qté</th><th class="num">Prix unit.</th><th class="num">Remise</th><th class="num">Total</th></tr></thead>
        <tbody>
            @foreach (var i in s.Items)
            {
                <tr>
                    <td>@i.Product?.Name</td>
                    <td class="num">@i.Quantity</td>
                    <td class="num">@i.UnitPrice.ToString("N2")</td>
                    <td class="num">@(i.DiscountPercent > 0 ? "-" + i.DiscountPercent.ToString("0.#") + "%" : "")</td>
                    <td class="num fw-semibold">@i.LineTotal.ToString("N2") DH</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="4" class="text-end text-muted">Sous-total</td><td class="num">@s.SubTotal.ToString("N2") DH</td></tr>
            <tr><td colspan="4" class="text-end text-muted">Remises</td><td class="num">-@s.Discount.ToString("N2") DH</td></tr>
            <tr><td colspan="4" class="text-end fw-bold">Total</td><td class="num fw-bold fs-5">@s.Total.ToString("N2") DH</td></tr>
        </tfoot>
    </table>
</div>
