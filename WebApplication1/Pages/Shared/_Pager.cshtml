@model PagerInfo
@{
    string Url(int p)
    {
        var q = Context.Request.Query
            .Where(kv => kv.Key != "p")
            .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"p={p}");
        return Context.Request.Path + "?" + string.Join("&", q);
    }
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
}
<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <small class="text-muted">@Model.Total résultat(s) — page @Model.Page / @Model.TotalPages</small>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page - 1)">&laquo;</a></li>
            @for (var i = from; i <= to; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page + 1)">&raquo;</a></li>
        </ul>
    }
</div>
