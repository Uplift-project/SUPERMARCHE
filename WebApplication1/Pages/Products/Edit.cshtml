@page "{id:int?}"
@model WebApplication1.Pages.Products.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nouveau produit" : "Modifier le produit";
}
<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>@(Model.IsNew ? "Ajouter un article au catalogue" : Model.Product.Name)</p>
    </div>
    <a asp-page="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Retour</a>
</div>

<div class="card-app" style="max-width:820px">
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Product.Id" />
        <input type="hidden" asp-for="Product.ImageUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Product.Name" class="form-label"></label>
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Product.Barcode" class="form-label"></label>
                <input asp-for="Product.Barcode" class="form-control" />
                <span asp-validation-for="Product.Barcode" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Product.CategoryId" class="form-label"></label>
                <select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="0">— Choisir —</option>
                </select>
                <div class="form-text">Choisissez de préférence une sous-catégorie (ex. Alimentation › Fruits & Légumes).</div>
                <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Product.Unit" class="form-label"></label>
                <input asp-for="Product.Unit" class="form-control" list="units" />
                <datalist id="units"><option>pièce</option><option>kg</option><option>litre</option><option>pack</option><option>paquet</option><option>bouteille</option><option>boîte</option></datalist>
            </div>
            <div class="col-md-4">
                <label asp-for="Product.Price" class="form-label"></label>
                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Product.Price" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Product.CostPrice" class="form-label"></label>
                <input asp-for="Product.CostPrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Product.CostPrice" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Product.MinQuantity" class="form-label"></label>
                <input asp-for="Product.MinQuantity" class="form-control" type="number" min="0" />
                <div class="form-text">Alerte quand le stock descend à ce niveau.</div>
            </div>

            @if (Model.IsNew)
            {
                <div class="col-md-4">
                    <label asp-for="InitialQuantity" class="form-label"></label>
                    <input asp-for="InitialQuantity" class="form-control" type="number" min="0" />
                    <div class="form-text">Enregistrée comme « Entrée de stock » à votre nom.</div>
                </div>
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle"></i> Stock actuel : <strong>@Model.Product.Quantity @Model.Product.Unit</strong>.
                        Pour le modifier, utilisez une <a asp-page="/Stock/Move" asp-route-productId="@Model.Product.Id">entrée / sortie de stock</a>
                        afin de garder la trace de qui a ajouté ou retiré.
                    </div>
                </div>
            }

            <div class="col-12"><hr class="my-1" /><h3 class="h6 fw-bold mt-2 mb-0"><i class="bi bi-shop"></i> Boutique en ligne</h3></div>

            <div class="col-md-8">
                <label asp-for="Product.Description" class="form-label"></label>
                <textarea asp-for="Product.Description" class="form-control" rows="5" placeholder="Origine, composition, conseils d'utilisation…"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Photo" class="form-label"></label>
                <div class="d-flex gap-3 align-items-start">
                    <div class="photo-preview" id="photoPreview">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl)) { <img src="@Model.Product.ImageUrl" alt="" /> }
                        else { <span>@(Model.Product.Emoji ?? "📷")</span> }
                    </div>
                </div>
                <input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control form-control-sm mt-2" id="photoInput" />
                <span asp-validation-for="Photo" class="text-danger small"></span>
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <div class="form-check mt-1">
                        <input asp-for="RemovePhoto" class="form-check-input" />
                        <label asp-for="RemovePhoto" class="form-check-label small">Supprimer la photo</label>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <label asp-for="Product.Emoji" class="form-label"></label>
                <input asp-for="Product.Emoji" class="form-control" maxlength="16" placeholder="🍅" />
                <div class="form-text">Affiché quand il n'y a pas de photo.</div>
            </div>

            <div class="col-12 d-flex flex-wrap gap-4">
                <div class="form-check form-switch">
                    <input asp-for="Product.IsActive" class="form-check-input" />
                    <label asp-for="Product.IsActive" class="form-check-label">Produit actif (visible en caisse et sur la boutique)</label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="Product.IsFeatured" class="form-check-input" />
                    <label asp-for="Product.IsFeatured" class="form-check-label">Mettre en avant sur la page d'accueil</label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Enregistrer</button>
            <a asp-page="Index" class="btn btn-light">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('photoInput')?.addEventListener('change', e => {
            const f = e.target.files[0];
            if (!f) return;
            const img = document.createElement('img');
            img.src = URL.createObjectURL(f);
            document.getElementById('photoPreview').replaceChildren(img);
        });
    </script>
}
