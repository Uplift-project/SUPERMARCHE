@page "{id:int?}"
@model WebApplication1.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Nouveau rôle" : "Modifier le rôle";
    var selected = Model.Selected.ToHashSet();
}
<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Cochez ce que les employés ayant ce rôle ont le droit de faire</p>
    </div>
    <a asp-page="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Retour</a>
</div>

<form method="post">
    <input type="hidden" asp-for="Role.Id" />
    <div class="card-app mb-4">
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="Role.Name" class="form-label"></label>
                <input asp-for="Role.Name" class="form-control" placeholder="Ex : Chef de rayon" />
                <span asp-validation-for="Role.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-7">
                <label asp-for="Role.Description" class="form-label">Description</label>
                <input asp-for="Role.Description" class="form-control" />
            </div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var g in Permissions.Groups)
        {
            <div class="col-md-6 col-xl-4">
                <div class="perm-group bg-white">
                    <h3>@g.Name</h3>
                    @foreach (var p in g.Items)
                    {
                        var id = "perm_" + p.Key.Replace(".", "_");
                        var allowed = Model.CanGrant(p.Key);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Selected" value="@p.Key" id="@id"
                                   checked="@selected.Contains(p.Key)" disabled="@(!allowed)" />
                            <label class="form-check-label" for="@id">@p.Label
                                @if (!allowed) { <i class="bi bi-lock text-muted" title="Vous ne possédez pas ce droit"></i> }
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary px-4"><i class="bi bi-check-lg"></i> Enregistrer</button>
        <a asp-page="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
