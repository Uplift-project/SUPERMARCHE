@page
@model WebApplication1.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <div class="text-center mb-4">
        <div class="brand"><i class="bi bi-basket2-fill" style="color:var(--app-accent)"></i> SuperMarché</div>
        <p class="text-muted mb-0">Espace d'administration</p>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="nom@supermarche.ma" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mot de passe</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Rester connecté</label>
        </div>
        <button class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right"></i> Se connecter</button>
    </form>
</div>
